# Runtime connection. In an RLS deployment this is the restricted oryh_app
# role; in plain single-role dev it can be the owning role directly.
ORYH_DATABASE_URL=postgresql+psycopg://ofbiz:ofbiz@127.0.0.1:5432/oryh
ORYH_DATABASE_SCHEMA=oryh

# Owning-role connection for alembic migrations and cross-tenant ops scripts
# (seed_demo, import_skill, create_platform_admin). Falls back to
# ORYH_DATABASE_URL when unset.
#ORYH_MIGRATION_DATABASE_URL=postgresql+psycopg://ofbiz:ofbiz@127.0.0.1:5432/oryh

# Password for the oryh_app runtime role; scripts/bootstrap_db_roles.py
# creates/refreshes the role when this is set (no-op otherwise).
#ORYH_APP_DB_PASSWORD=change-me

# Password-reset emails use a short-lived one-time link (default: 60 minutes).
#ORYH_PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Production canonical URL for website, email links, and rendered skill bundles.
#ORYH_BASE_URL=https://app.example.com

# Email delivery. An SMTP relay may authenticate by a deployment's fixed
# public egress IP, so ORYH_SMTP_USER and ORYH_SMTP_PASSWORD can stay unset
# when the relay is configured for IP-based authentication.
#ORYH_EMAIL_BACKEND=smtp
#ORYH_SMTP_HOST=smtp-relay.gmail.com
#ORYH_SMTP_PORT=587
#ORYH_SMTP_SECURITY=starttls
#ORYH_SMTP_FROM=service@example.com
#ORYH_SMTP_FROM_NAME=oryh

# Docker Compose image coordinates. Production should pin immutable release
# tags; local development defaults to oryh-api:latest and
# oryh-console:latest.
#ORYH_API_IMAGE=registry.example.com/oryh/api
#ORYH_API_TAG=2026.07.12-1
#ORYH_CONSOLE_IMAGE=registry.example.com/oryh/console
#ORYH_CONSOLE_TAG=2026.07.12-1
# Public Docker Compose nginx gateway port. The static console itself stays
# internal on port 8080.
#ORYH_CONSOLE_PORT=8080

# Do not persist ORYH_SKIP_STARTUP_MAINTENANCE here. rollback.sh injects it
# only while switching to an older API image; normal startup must run migrations.

# --- standalone deployment (docker-compose.yml) -----------------------------
# Which assembly to run. Normally unset: it resolves to "cloud" when the
# source tree carries app/saas and "standalone" when it does not. Set it only
# to run a cloud-capable image as a standalone instance (the standalone
# compose file already does).
#ORYH_EDITION=standalone

# First-boot workspace facts, read once while the database has no tenant at
# all and inert afterwards. Leave the password unset to have one generated
# and printed ONCE to the api service log alongside the agent service key.
#ORYH_STANDALONE_COMPANY_NAME=我的公司
#ORYH_STANDALONE_ADMIN_EMAIL=admin@example.com
#ORYH_STANDALONE_ADMIN_PASSWORD=

# Brand prefix stamped onto outbound skill bundles: installed skill names
# ({brand}-{slug}-...), the install directory ({brand}-skills-{slug}), and the
# bootstrap connect skill ({brand}-connect). Registry names stay canonical
# oryh-*; this changes rendering only. Fix it per environment (e.g. "calwbiz"
# on dev/test boxes) so bundles from different environments install side by
# side on one laptop; changing it on a live server means every agent
# re-installs its bundle on next sync.
#ORYH_SKILL_BRAND=oryh
